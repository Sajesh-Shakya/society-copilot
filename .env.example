# Browser/server Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only Supabase configuration
SUPABASE_SECRET_KEY=sb_secret_your-key

# Base URLs used by auth callbacks and the sync dispatcher
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VERCEL_APP_URL=http://localhost:3000

# Authentication for machine-to-machine routes
CRON_SECRET=replace-with-a-long-random-value
SYNC_TRIGGER_SECRET=replace-with-a-different-long-random-value

# eActivities read access
EACTIVITIES_API_KEY=replace-with-your-eactivities-api-key
EACTIVITIES_CSP_CODE=replace-with-your-csp-code

# Chase email sending (only required when sending is enabled)
RESEND_API_KEY=re_your-key
CHASE_FROM_EMAIL=Society Ops <payments@example.com>

# Optional chase behavior
# CHASE_THRESHOLD_DAYS=7
# CHASE_AUTO_SEND_REPEATS=false
